# LLM providers (Groq is primary, Gemini is fallback)
GROQ_API_KEY=your_groq_key_here
GOOGLE_API_KEY=your_google_key_here
LLM_PROVIDER=groq

# ── AI stone-vision judge (Layer B, app/llm/gem_vision.py) ────────────────
# The AI vision model is the PRIMARY judge of stone count + position + type; the
# ML/SAM detector is secondary (precise boundaries + a safety net). Fireworks +
# Kimi K2.6 is the AI provider, Gemini is the fallback.
# Fully guarded — no key / any failure => ML-only.
#
# Model note: the Qwen-VL and Llama-vision IDs return 404 "not deployed" on this
# account (checked with scripts/compare_gem_vision.py), so Kimi is the model
# that actually works. Re-run that script if the account's catalog changes.
FIREWORKS_API_KEY=your_fireworks_key_here
GEM_VISION_PROVIDER=fireworks            # fireworks | gemini | auto
FIREWORKS_VISION_MODEL=accounts/fireworks/models/kimi-k2p6
# Kimi reasons at length before answering (~8.7k tokens / ~90s on a pavé ring).
# Measured: 4096 tokens => truncated mid-reasoning => 0 stones. Do NOT lower
# these, and do NOT set response_format=json_object (it starves the budget).
GEM_VISION_MAX_TOKENS=16384
GEM_VISION_TIMEOUT_S=180
USE_AI_STONE_CONFIRM=1                    # set 0 to force ML-only

# Robustness layer (app/llm/gem_vision.py) — the fix for "fails on a few images".
# VOTES independent calls are merged by spatial consensus so one junk/empty run
# can't zero out a good one; MIN_SIDE upscales small catalogue crops so tiny pavé
# is resolvable. VOTES=1 + MIN_SIDE=0 => byte-identical to the single-call path.
GEM_VISION_VOTES=2                        # independent AI passes to reconcile (1 = off)
GEM_VISION_MIN_SIDE=640                   # upscale crop short side to >= this px (0 = off)
GEM_VISION_OUTER_TIMEOUT_S=300            # bounds the whole voting round
GEM_VISION_AGREE_FLOOR=0.6               # min fraction of confidence a minority-vote stone keeps
GEM_VISION_CLUSTER_FRAC=0.03            # cross-vote same-stone distance = this * crop short side

# Reconciliation policy (app/utils/stone_fusion.py):
STONE_AI_PRIMARY=1                        # 1 = AI leads (AI-only can be confirmed,
                                         #     uncorroborated ML demoted to secondary);
                                         # 0 = older balanced "best-of-both" policy
STONE_AI_ONLY=1                           # 1 = STRICTLY AI-based: the AI alone decides the
                                         #     stone set (ML only refines boundaries); AI
                                         #     detection then works even when the backdrop
                                         #     cannot be separated. 0 = keep ML as secondary
STONE_AI_CONFIRM_MIN=0.45                 # AI confidence >= this => "confirmed" (governs
                                         #     matched stones too), below => "uncertain"
# Graceful degradation: when the AI vision judge returns ZERO stones but the CV
# pass is confident it found some (tiny pavé / illusion settings the model
# under-reads), recover those as UNCERTAIN + needs_review instead of reporting
# bare metal. Never asserts them confirmed; never fires when the AI saw stones.
STONE_RESCUE_ML_ON_AI_EMPTY=1             # 0 = strict AI-only (drop to zero, old behaviour)
STONE_RESCUE_ML_MIN_CONF=0.60            # CV confidence a stone needs to be recovered for review
# AI-only stones are validated against the ornament's convex-hull envelope
# (includes openwork gaps — pavé kite frames, prong-set clusters), dilated by
# this fraction of the item's short side so edge pavé isn't clipped. Larger =
# recovers more edge stones, at some risk of accepting an off-item reflection.
STONE_AI_ENVELOPE_MARGIN_FRAC=0.04

# Roboflow (DS-4 jewelry dataset)
# Get key: https://roboflow.com → Settings → API
ROBOFLOW_API_KEY=your_roboflow_key_here

# Kaggle (DS-2 NEU defect, DS-3 Tanishq)
# Get credentials: https://www.kaggle.com/settings → API → Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_API_KEY=your_kaggle_api_key

# Server
PORT=8000

# Liveness detection — set to 0 in development when no webcam is available
# (the /api/auth/selfie endpoint will skip the server-side face-presence check)
ENFORCE_FACE_ON_SELFIE=1
